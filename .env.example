ANTHROPIC_API_KEY=
# Optional. Powers real semantic search in retrieve_context (Voyage AI is
# Anthropic's recommended embeddings provider). Without it, retrieval falls
# back to word-overlap matching - the pipeline still runs, just less well.
VOYAGE_API_KEY=

# Optional - only used by src/shared/mailer.js, for the summary email an
# automated (auto-review) build-vs-buy-eval run sends after finishing. Leave
# blank to skip emailing; the summary is still generated either way. Works
# with any SMTP provider - e.g. Gmail SMTP with an app password (not your
# real password), or a transactional provider like Resend/Postmark/SES.
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
EMAIL_FROM=
EMAIL_TO=
